# Copy to .env and fill in secrets. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=true


DB_URI=sqlite:///./demo.db
# DB_URI=postgresql+psycopg2://readonly_user:password@host:5432/dbname
# DB_SCHEMA_NAME=public
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
STATEMENT_TIMEOUT_MS=15000
MAX_RESULT_ROWS=500

# ollama (local, no API key) | openai | azure | local (Transformers)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:latest

# Optional hosted providers- not needed for the default Ollama setup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://vllm:8000/v1

# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# LLM_PROVIDER=local
# LOCAL_TEXT2SQL_MODEL_NAME=defog/sqlcoder-7b-alpha
# LOCAL_DEVICE=cpu

MAX_CONCURRENT_QUERIES=32
RATE_LIMIT_PER_MINUTE=60
MAX_SCHEMA_TABLES_IN_PROMPT=12
PIPELINE_RETRIES=2

# Comma-separated. Required when ENVIRONMENT=production.
API_KEYS=
CORS_ORIGINS=*

RESULT_CACHE_TTL_SECONDS=0
ENABLE_EXACT_SQL_CACHE=true
ENABLE_SEMANTIC_CACHE=false
